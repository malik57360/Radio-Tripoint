# ─── Radio Tripoint — variables d'environnement ───────────────────────────
# Toutes sont facultatives : le site démarre et reste propre sans aucune.
# Une valeur absente = la fonction correspondante s'affiche « non configurée »
# au lieu d'inventer quoi que ce soit.

# URL publique du site (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.radio-tripoint-officiel.fr

# Flux audio du direct (URL MP3/AAC fournie par Radioking, rubrique
# « Diffusion > Liens d'écoute »). Sans elle, le bouton d'écoute renvoie
# vers le player externe si NEXT_PUBLIC_RADIOKING_URL est renseignée.
NEXT_PUBLIC_STREAM_URL=

# Page du player Radioking (lien « Ouvrir le player »).
NEXT_PUBLIC_RADIOKING_URL=

# Endpoint JSON « titre en cours » (lu côté serveur par /api/en-direct).
# Format Radioking attendu : { title, artist, cover, ... }. Laisser vide
# pour ne rien afficher.
RADIO_NOW_PLAYING_URL=

# Réception des formulaires par e-mail, pièce jointe comprise, via Resend
# (resend.com, gratuit jusqu'à 3 000 e-mails/mois). Clé API « re_… ».
# Prioritaire sur le webhook ci-dessous quand elle est renseignée.
RESEND_API_KEY=
# Destinataire (par défaut : l'e-mail de contact de config/site.ts). Tant
# qu'aucun domaine n'est vérifié chez Resend, ce doit être l'adresse du
# compte Resend, et l'expéditeur rester onboarding@resend.dev.
FORM_EMAIL_TO=
# Expéditeur, une fois le domaine vérifié chez Resend. Ex. :
# Radio Tripoint <formulaires@radio-tripoint-officiel.fr>
FORM_EMAIL_FROM=

# Webhook qui reçoit les formulaires (contact, info, publicité, newsletter)
# en POST multipart. Make, n8n, Zapier, Formspree… au choix de l'éditeur.
# Utilisé seulement sans RESEND_API_KEY. Sans l'un ni l'autre, les
# formulaires proposent l'envoi par e-mail à la place.
FORM_WEBHOOK_URL=
# Jeton partagé envoyé dans l'en-tête X-Webhook-Token (facultatif).
FORM_WEBHOOK_TOKEN=

# Contenu de démonstration (articles, épisodes, événements FICTIFS,
# badgés « Exemple »). Réservé aux maquettes : ne JAMAIS l'activer en prod.
NEXT_PUBLIC_DEMO_CONTENT=0

# Guide « Tripo » (chatbot). GUIDE_ACTIF=1 affiche le bouton « Guide »
# (à n'activer qu'une fois AI Gateway utilisable : carte bancaire
# enregistrée sur Vercel). Sur Vercel, il s'authentifie tout seul auprès
# d'AI Gateway (jeton OIDC du projet) : rien à renseigner. En local, mettre
# une clé AI Gateway. Le modèle se change sans toucher au code.
GUIDE_ACTIF=0
# Clé Anthropic (console.anthropic.com) : appel direct, prioritaire sur
# AI Gateway. À saisir dans Vercel en variable « Sensitive ».
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
# Modèle : « claude-sonnet-5-5 » avec la clé Anthropic,
# « anthropic/claude-sonnet-5.5 » via AI Gateway (valeurs par défaut).
GUIDE_MODELE=
