{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "framework": "nextjs",
  "functions": {
    "api/tripo_voix.py": {
      "memory": 1024,
      "maxDuration": 30,
      "excludeFiles": "{.next/**,node_modules/**,public/**,app/**,components/**,data/**,lib/**,assets/**,scripts/**,types/**,config/**,*.md,api/oreille/**}"
    },
    "api/tripo_oreille.py": {
      "memory": 2048,
      "maxDuration": 30,
      "excludeFiles": "{.next/**,node_modules/**,public/**,app/**,components/**,data/**,lib/**,assets/**,scripts/**,types/**,config/**,*.md,api/voix/**}"
    }
  },
  "crons": [
    {
      "path": "/api/horoscope",
      "schedule": "5 23 * * *"
    },
    {
      "path": "/api/prospection/quotidien",
      "schedule": "5 3 * * *"
    }
  ]
}
